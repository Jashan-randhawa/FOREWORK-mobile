# Expo inlines any env var prefixed EXPO_PUBLIC_ into the client bundle at
# build time — never put a secret here. This is the ONLY base URL source
# for the app (see src/utils/endpoints.ts); do not add a second one.
EXPO_PUBLIC_API_URL=http://localhost:5001

# For a physical device or EAS build pointed at the deployed Railway API,
# use the real backend URL instead, e.g.:
# EXPO_PUBLIC_API_URL=https://forework-api.up.railway.app
